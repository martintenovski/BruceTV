<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#E6224A8F" />
            <stroke android:width="2dp" android:color="#8FC2FF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="?attr/btnFill1" android:endColor="?attr/btnFill2" />
            <stroke android:width="?attr/rimW" android:color="?attr/rimStroke" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
