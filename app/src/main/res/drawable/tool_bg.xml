<?xml version="1.0" encoding="utf-8"?>
<!-- Dock tool: in the glass skins a near-clear cut-out (the blurred wallpaper shows through the dock), solid white while focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="#FFFFFFFF" /><corners android:radius="14dp" /></shape></item>
    <item>
        <shape>
            <solid android:color="?attr/toolFill" />
            <stroke android:width="?attr/rimW" android:color="?attr/toolRim" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
