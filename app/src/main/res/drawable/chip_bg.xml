<?xml version="1.0" encoding="utf-8"?>
<!-- Top-right chip: white in Default; in the glass skins and dark mode the same fill, rim and sheen as the dock. Solid white while focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="#FFFFFFFF" /><corners android:radius="999dp" /></shape></item>
    <item>
        <layer-list>
            <item>
                <shape>
                    <gradient android:angle="270" android:startColor="?attr/chipFill1" android:endColor="?attr/chipFill2" />
                    <stroke android:width="?attr/rimW" android:color="?attr/chipRim" />
                    <corners android:radius="999dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <gradient android:angle="270" android:startColor="?attr/chipSheen" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" android:centerY="0.45" />
                    <corners android:radius="999dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
