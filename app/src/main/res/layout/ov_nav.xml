<?xml version="1.0" encoding="utf-8"?>
<!-- Apps + Recent overlays: shared by every home layout; MainActivity.tweakNav() fits them around each layout's nav. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/navHost"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/appsOverlay"
        android:clipChildren="true"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="108dp"
        android:paddingEnd="48dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/appsTitle"
            style="@style/Shadowed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="All apps"
            android:textColor="#FFFFFF"
            android:textSize="26sp" />

        <TextView
            style="@style/Shadowed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.8"
            android:text="Hold OK or press Menu on an app to pin it to Home, move or uninstall it"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="-48dp"
            android:layout_marginEnd="-48dp"
            android:layout_weight="1"
            android:clipChildren="true"
            android:clipToPadding="false"
            android:paddingStart="48dp"
            android:paddingTop="52dp"
            android:paddingEnd="48dp"
            android:paddingBottom="44dp"
            android:scrollbars="none">

            <GridLayout
                android:id="@+id/grid"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:clipChildren="false"
                android:padding="16dp"
                android:columnCount="6" />
        </ScrollView>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/recentOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <TextView
            style="@style/Shadowed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_marginTop="108dp"
            android:fontFamily="sans-serif-medium"
            android:text="Recent Apps"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_marginTop="108dp"
            android:layout_marginEnd="48dp"
            android:background="@drawable/glass_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/ramText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/ramBar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="80dp"
                android:layout_height="5dp"
                android:layout_marginStart="10dp"
                android:max="100"
                android:progressDrawable="@drawable/ram_bar" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/recentRow"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="horizontal"
                android:paddingStart="48dp"
                android:paddingTop="16dp"
                android:paddingEnd="48dp"
                android:paddingBottom="24dp" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="76dp"
            android:clipChildren="false"
            android:orientation="horizontal">

            <TextView android:id="@+id/actOptimize" style="@style/Action" android:layout_width="170dp" android:layout_weight="0" android:text="Optimize" />
            <TextView android:id="@+id/actRestart" style="@style/Action" android:layout_width="170dp" android:layout_weight="0" android:text="Restart" />
        </LinearLayout>

        <TextView
            android:id="@+id/recentHint"
            style="@style/Shadowed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="40dp"
            android:alpha="0.65"
            android:text="Hold OK on an app to close it  ·  OK to open"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </FrameLayout>
</FrameLayout>
